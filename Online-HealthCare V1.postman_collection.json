      "name": "Auth",
      "item": [
        {
          "name": "Register Patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Uddin\",\n  \"email\": \"rahim.uddin@gmail.com\",\n  \"password\": \"StrongPass@123\",\n  \"patient\": {\n    \"contactNumber\": \"+8801711000000\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Registers a new patient. Password must be minimum 8 characters with at least one uppercase, lowercase, digit and special character. An OTP is sent to the email which is needed to verify the email."
          },
          "response": []
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahim.uddin@gmail.com\",\n  \"otp\": \"123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "verify-email"
              ]
            },
            "description": "Verifies the patient email with the OTP received from Register Patient. Returns accessToken & refreshToken (also set as httpOnly cookies). Copy accessToken into the {{patientToken}} variable."
          },
          "response": []
        },
        {
          "name": "Credential Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rahim.uddin@gmail.com\",\n  \"password\": \"StrongPass@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Logs in a user with email & password. Returns accessToken & refreshToken (also set as httpOnly cookies). Copy accessToken into the appropriate role variable ({{patientToken}} / {{doctorToken}} / {{adminToken}})."
          },
          "response": []
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns the currently logged-in user profile with patient info. Works for SUPER_ADMIN, ADMIN, DOCTOR and PATIENT roles."
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Cookie",
                "value": "refreshToken={{refreshToken}}"
