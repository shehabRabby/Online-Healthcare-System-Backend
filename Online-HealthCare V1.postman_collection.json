            },
            "url": {
              "raw": "{{baseUrl}}/appointment/book-appointment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointment",
                "book-appointment"
              ]
            },
            "description": "Patient books an appointment against a PUBLISHED schedule that is available today. Creates a PENDING appointment and returns a bKash paymentUrl. Use a scheduleId from /schedule/todays-schedule or a doctor's available-today schedule."
          },
          "response": []
        },
        {
          "name": "Pay Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/appointment/pay-appointment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointment",
                "pay-appointment"
              ]
            },
            "description": "Patient re-initiates payment for a PENDING appointment. Returns a fresh bKash paymentUrl."
          },
          "response": []
        },
        {
          "name": "Cancel Appointment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patientToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"appointmentId\": \"{{appointmentId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/appointment/cancel-appointment",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointment",
                "cancel-appointment"
              ]
            },
            "description": "Cancels an appointment (owner patient / admin / super admin). If cancelled at least 1 hour before start time, the payment is automatically refunded via bKash."
          },
          "response": []
        },
        {
          "name": "Book Appointment Payment Callback",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/appointment/book-appointment/payment/callback?paymentID={{paymentID}}&status=success",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "appointment",
                "book-appointment",
                "payment",
                "callback"
              ],
              "query": [
                {
                  "key": "paymentID",
                  "value": "{{paymentID}}",
                  "description": "bKash payment ID received by callback."
                },
                {
                  "key": "status",
                  "value": "success",
                  "description": "success | failure | cancel"
                }
              ]
            },
            "description": "bKash callback URL. Called automatically by bKash after payment. Confirms the appointment, decrements schedule slots, marks payment PAID and emails the patient an invoice PDF. Redirects back to the frontend."
          },
          "response": []
        },
