            ],
            "url": {
              "raw": "{{baseUrl}}/auth/refresh-token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh-token"
              ]
            },
            "description": "Generates a new accessToken & refreshToken. Requires the refreshToken httpOnly cookie which is set after login/verify-email. Add a {{refreshToken}} cookie variable if testing manually."
          },
          "response": []
        },
