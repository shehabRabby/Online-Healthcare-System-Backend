<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Approved</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        background: linear-gradient(135deg, #0f766e, #0d9488);
        padding: 32px 30px;
        text-align: center;
      }

      .logo {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        background: #ffffff;
        border-radius: 50%;
        display: table;
        text-align: center;
      }

      .logo span {
        display: table-cell;
        vertical-align: middle;
        color: #0f766e;
        font-size: 28px;
        font-weight: bold;
      }

      .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
      }

      .header p {
        margin: 8px 0 0;
        color: #dff7f5;
        font-size: 14px;
      }

      /* Content */
      .content {
        padding: 38px 35px;
      }

      .greeting {
        margin: 0 0 18px;
        font-size: 22px;
        font-weight: 700;
        color: #111827;
      }

      .content p {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      /* Success Box */
      .success-box {
        margin: 25px 0;
        padding: 18px 20px;
        background: #ecfdf5;
        border: 1px solid #a7f3d0;
        border-radius: 10px;
        text-align: center;
      }

      .success-icon {
        font-size: 26px;
        margin-bottom: 8px;
      }

      .success-box strong {
        display: block;
        color: #047857;
        font-size: 16px;
        margin-bottom: 5px;
      }

      .success-box span {
        color: #065f46;
        font-size: 13px;
      }

      /* Button */
      .button-wrapper {
        text-align: center;
        margin: 28px 0 10px;
      }

      .button {
        display: inline-block;
        padding: 13px 28px;
        background: #0f766e;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
      }

      /* Footer */
      .footer {
        padding: 22px 30px;
        background: #f8fafc;
        border-top: 1px solid #e5e7eb;
        text-align: center;
      }

      .footer p {
        margin: 0 0 6px;
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.5;
      }

      .footer strong {
        color: #6b7280;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 28px 20px;
        }

        .header h1 {
          font-size: 21px;
        }

        .greeting {
          font-size: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">
            <span>+</span>
          </div>

          <h1>Application Approved</h1>
          <p>Welcome to Online Healthcare System</p>
        </div>

        <!-- Content -->
        <div class="content">

          <h2 class="greeting">
            Congratulations, Dr. <%= name %>! 🎉
          </h2>

          <p>
            We are pleased to inform you that your application to join
            <strong>Online Healthcare System</strong> as a doctor has been
            reviewed and successfully approved.
          </p>

          <div class="success-box">
            <div class="success-icon">✓</div>
            <strong>Your application has been approved</strong>
            <span>
              You are now officially part of the Online  Healthcare System.
            </span>
          </div>

          <p>
            You can now log in to your account and start managing your
            schedule, consultations, and other professional activities.
          </p>

          <div class="button-wrapper">
            <a href="#" class="button">
              Login to Your Account
            </a>
          </div>

          <p style="margin-top: 25px; font-size: 13px; color: #6b7280;">
            Thank you for choosing Online Healthcare System. We look forward to
            having you as part of our healthcare community.
          </p>

        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            © <strong>Online Healthcare System</strong>. All rights reserved.
          </p>
          <p>
            This is an automated email. Please do not reply to this message.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>