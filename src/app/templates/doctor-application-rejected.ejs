```html
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Application Update</title>

    <style>
      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        padding: 0;
        background-color: #f4f7fb;
        font-family: Arial, Helvetica, sans-serif;
        color: #1f2937;
      }

      .wrapper {
        width: 100%;
        padding: 40px 15px;
      }

      .container {
        max-width: 560px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
      }

      /* Header */
      .header {
        background: linear-gradient(135deg, #475569, #64748b);
        padding: 32px 30px;
        text-align: center;
      }

      .logo {
        width: 58px;
        height: 58px;
        margin: 0 auto 15px;
        background: #ffffff;
        border-radius: 50%;
        display: table;
        text-align: center;
      }

      .logo span {
        display: table-cell;
        vertical-align: middle;
        color: #475569;
        font-size: 27px;
        font-weight: bold;
      }

      .header h1 {
        margin: 0;
        color: #ffffff;
        font-size: 24px;
        font-weight: 700;
      }

      .header p {
        margin: 8px 0 0;
        color: #e2e8f0;
        font-size: 14px;
      }

      /* Content */
      .content {
        padding: 38px 35px;
      }

      .greeting {
        margin: 0 0 18px;
        font-size: 22px;
        font-weight: 700;
        color: #111827;
      }

      .content p {
        margin: 0 0 16px;
        font-size: 15px;
        line-height: 1.7;
        color: #4b5563;
      }

      /* Notice Box */
      .notice-box {
        margin: 25px 0;
        padding: 18px 20px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 10px;
      }

      .notice-box strong {
        display: block;
        color: #c2410c;
        font-size: 16px;
        margin-bottom: 6px;
      }

      .notice-box span {
        color: #7c2d12;
        font-size: 13px;
        line-height: 1.5;
      }

      /* Reason */
      .reason {
        margin: 25px 0;
        padding: 18px 20px;
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-left: 4px solid #dc2626;
        border-radius: 8px;
        color: #7f1d1d;
        font-size: 14px;
        line-height: 1.6;
      }

      .reason strong {
        display: block;
        margin-bottom: 6px;
        color: #b91c1c;
        font-size: 14px;
      }

      /* Footer */
      .footer {
        padding: 22px 30px;
        background: #f8fafc;
        border-top: 1px solid #e5e7eb;
        text-align: center;
      }

      .footer p {
        margin: 0 0 6px;
        font-size: 12px;
        color: #9ca3af;
        line-height: 1.5;
      }

      .footer strong {
        color: #6b7280;
      }

      @media only screen and (max-width: 600px) {
        .wrapper {
          padding: 20px 10px;
        }

        .content {
          padding: 30px 22px;
        }

        .header {
          padding: 28px 20px;
        }

        .header h1 {
          font-size: 21px;
        }

        .greeting {
          font-size: 20px;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <div class="container">

        <!-- Header -->
        <div class="header">
          <div class="logo">
            <span>Online-Healthcare</span>
          </div>

          <h1>Application Update</h1>
          <p>Online Healthcare System</p>
        </div>

        <!-- Content -->
        <div class="content">

          <h2 class="greeting">
            Hello Dr. <%= name %>,
          </h2>

          <p>
            Thank you for taking the time to apply to
            <strong>Online Healthcare System</strong>.
          </p>

          <p>
            After carefully reviewing your application, we regret to inform
            you that we are unable to approve your application at this time.
          </p>

          <!-- Status -->
          <div class="notice-box">
            <strong>Application Not Approved</strong>
            <span>
              Your application did not meet the current requirements for
              joining Online Healthcare System.
            </span>
          </div>

          <!-- Reason -->
          <% if (reason) { %>
            <div class="reason">
              <strong>Reason for this decision</strong>
              <%= reason %>
            </div>
          <% } %>

          <p style="margin-top: 25px; font-size: 13px; color: #6b7280;">
            We appreciate your interest in joining our healthcare community
            and wish you the very best in your professional journey.
          </p>

        </div>

        <!-- Footer -->
        <div class="footer">
          <p>
            © <strong>Online Healthcare System</strong>. All rights reserved.
          </p>
          <p>
            This is an automated email. Please do not reply to this message.
          </p>
        </div>

      </div>
    </div>
  </body>
</html>
```
